  "keyFeatures": [
    "Seat reservation with contiguous-seat validation",
    "Reservation expiry (1 minute) and purchase flow",
    "Event Sourcing with Kurrent DB as the event store",
    "CQRS with separate Command and Query APIs",
    "Multi-tenant support with user authorization",
    "MCP Gateway for AI-agent integration",
    "Reservation SDK for .NET client integration",
    "OpenTelemetry tracing with Aspire dashboard",
    "API versioning (V1 and V2 contracts)",
    "Swagger UI with JWT authentication support"
  ],
  "publicApiSurface": [
    "POST /api/v2/showtimes/{showtimeId}/reservations — Reserve seats",
    "PUT  /api/v2/reservations/{reservationId}/purchase — Purchase reservation",
    "GET  /api/v2/showtimes — List showtimes",
    "GET  /api/v2/showtimes/{showtimeId} — Get showtime details",
    "GET  /api/v2/auditoriums — List auditoriums",
    "GET  /api/v2/auditoriums/{auditoriumId} — Get auditorium details",
    "GET  /api/v2/reservations/{reservationId} — Get reservation details",
    "ReservationSdkExtensions — .NET SDK registration",
    "MCP Gateway tools: get-auditoriums, get-movies, get-showtimes, manage-reservations"
  ]
}
