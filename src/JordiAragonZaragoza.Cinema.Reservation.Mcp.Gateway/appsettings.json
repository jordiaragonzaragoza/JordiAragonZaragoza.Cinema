{
  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "OpenTelemetry"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithMachineName",
      "WithThreadName",
      "WithThreadId"
    ]
  },
  "ServiceIdentity": {
    "Name": "cinema-reservation-mcp-gateway"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "<authority-url>",
        "Audience": "<API-client-id>"
      }
    }
  },
  "Mcp": {
    "ResourceUrl": "<public-gateway-url>"
  }
}