{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Async", "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug",
        "Microsoft.AspNetCore.Authentication": "Information"
      }
    },
    "WriteTo":[
            {
                "Name": "Async",
                "Args": {
                  "configure": [{
                    "Name": "Console"
                  }]
                }
            },
            {
                "Name": "OpenTelemetry"
            }
        ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithMachineName", "WithThreadName", "WithThreadId" ]
  },
  "Mcp": {
    "ResourceUrl": "http://localhost:5003"
  }
}