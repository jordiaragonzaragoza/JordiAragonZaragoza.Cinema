{
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "Audience": "<API-client-id>"
      }
    },
    "Claims": {
      "UserIdClaimType": "oid"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "OpenTelemetry"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithMachineName",
      "WithThreadName",
      "WithThreadId"
    ]
  },
  "ServiceIdentity": {
    "Name": "cinema-reservation-api-command"
  }
}